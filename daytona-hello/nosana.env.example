# Nosana 接続設定。cp nosana.env.example nosana.env して下の2つを埋めるだけ(nosana.env はコミットしない)

# API キー: https://deploy.nosana.com → Account → API Keys で発行(nos_ で始まる)
NOSANA_API_KEY=

# モデル名: 埋めたあと `npm run check:nosana` を実行すると使えるモデル一覧が出る
NOSANA_MODEL=

# 接続先(通常は変更不要)。自分で vLLM を Nosana にデプロイした場合のみ
# https://<job-id>.node.k8s.prd.nos.ci/v1 のように書き換える
NOSANA_BASE_URL=https://inference.nosana.com/v1
